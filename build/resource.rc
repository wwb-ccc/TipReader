// TipReader Windows 资源：应用程序图标 + 版本信息（exe 属性/悬停显示名称）
1 ICON "appicon.ico"

1 VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription",  "TipReader 提词器"
            VALUE "ProductName",      "TipReader"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "ProductVersion",   "1.1.0.0"
            VALUE "InternalName",     "TipReader"
            VALUE "OriginalFilename", "TipReader.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
